# PathLens AI — Compose environment (copy to .env and fill)
# Secrets: never commit real keys. See docs/SECURITY.md (G1 added)
# G1 FIX: old api.meta.ai/compat/v1 returned 404. Use correct endpoint below.

POSTGRES_PASSWORD=pathlens_local_dev
JWT_SIGNING_KEY=LOCAL_DEV_ONLY_CHANGE_ME_PATHLENS_SIGNING_KEY_32CHARS
JWT_ISSUER=PathLens
JWT_AUDIENCE=PathLensWeb
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5145
API_PORT=5145
WEB_PORT=3000
DB_PORT=5433
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_STALE_DAYS=30
# AI provider — G1 live: set to Meta + fill 3 keys below. For tests use Mock explicitly.
AI_PROVIDER=Meta
# Option A (Meta Llama API): https://api.llama.com/v1/chat/completions + Llama-4-Maverick-17B-128E-Instruct-FP8
# Option B (Groq fast): https://api.groq.com/openai/v1/chat/completions + meta-llama/llama-4-maverick-17b-128e-instruct
META_AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
META_AI_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
META_AI_API_KEY=  # paste real key here locally; production via GitHub Secrets META_AI_API_KEY
CAMERAS_POLLING_ENABLED=false
ASPNETCORE_ENVIRONMENT=Development
